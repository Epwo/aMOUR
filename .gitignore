# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
src/.venv/

# ── Audio files (large / potentially copyrighted) ─────────────────────────────
data/**/*.mp3
data/**/*.webm
data/**/*.wav
data/**/*.flac
data/**/*.ogg
data/**/*.m4a
data/**/*.aac
data/**/*.opus
data/**/*.zip
data/.tmp_download/
# Keep the data/ folder itself (for README instructions)
!data/.gitkeep

# ── FMA dataset (downloaded via download_fma.py) ─────────────────────────────
data/fma_small/
data/fma_metadata/

# ── Generated artefacts ────────────────────────────────────────────────────────
embeddings/*.npz
embeddings/*.npy
# Keep the embeddings/ folder itself
!embeddings/.gitkeep

# ── Plots / exports ────────────────────────────────────────────────────────────
*.html
plots/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
